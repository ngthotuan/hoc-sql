---
// Ba lựa chọn: Sáng / Tối / Theo máy. Lưu vào localStorage("theme").
// Script chống nháy màu nằm trong <head> của Base.astro.
---

<div class="theme-switch" role="group" aria-label="Giao diện">
  <button type="button" data-theme-choice="light" aria-pressed="false" title="Giao diện sáng">
    <svg viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="3.6" /><path d="M10 1.8v2.4M10 15.8v2.4M1.8 10h2.4M15.8 10h2.4M4.2 4.2l1.7 1.7M14.1 14.1l1.7 1.7M4.2 15.8l1.7-1.7M14.1 5.9l1.7-1.7" /></svg>
    <span class="sr-only">Sáng</span>
  </button>
  <button type="button" data-theme-choice="dark" aria-pressed="false" title="Giao diện tối">
    <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M15.8 12.6A6.6 6.6 0 0 1 7.4 4.2a6.6 6.6 0 1 0 8.4 8.4Z" /></svg>
    <span class="sr-only">Tối</span>
  </button>
  <button type="button" data-theme-choice="system" aria-pressed="false" title="Theo cài đặt của máy">
    <svg viewBox="0 0 20 20" aria-hidden="true"><rect x="2.5" y="3.5" width="15" height="10" rx="1.5" /><path d="M7 17h6M10 13.5V17" /></svg>
    <span class="sr-only">Theo máy</span>
  </button>
</div>

<script>
  const KEY = 'theme';
  const root = document.documentElement;

  function read(): string {
    try {
      return localStorage.getItem(KEY) ?? 'system';
    } catch {
      return 'system';
    }
  }

  function apply(choice: string) {
    if (choice === 'light' || choice === 'dark') root.dataset.theme = choice;
    else delete root.dataset.theme;
    try {
      if (choice === 'system') localStorage.removeItem(KEY);
      else localStorage.setItem(KEY, choice);
    } catch {
      /* chế độ ẩn danh: vẫn đổi được, chỉ không nhớ */
    }
    document.querySelectorAll<HTMLButtonElement>('[data-theme-choice]').forEach((b) => {
      b.setAttribute('aria-pressed', String(b.dataset.themeChoice === choice));
    });
  }

  apply(read());
  document.querySelectorAll<HTMLButtonElement>('[data-theme-choice]').forEach((b) => {
    b.addEventListener('click', () => apply(b.dataset.themeChoice!));
  });
</script>

<style>
  .theme-switch {
    display: inline-flex;
    padding: 2px;
    gap: 2px;
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    background: var(--surface);
  }
  button {
    display: grid;
    place-items: center;
    width: 2rem;
    height: 2rem;
    padding: 0;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--ink-soft);
    cursor: pointer;
  }
  button:hover { color: var(--ink); }
  button[aria-pressed='true'] { background: var(--ink); color: var(--paper); }
  button:focus-visible { border-radius: 999px; }
  svg {
    width: 1.1rem;
    height: 1.1rem;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>
